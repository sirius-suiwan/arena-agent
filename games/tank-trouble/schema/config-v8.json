{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tank Trouble v8 match config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cols": {"type": "integer", "minimum": 4, "maximum": 16, "default": 12},
    "rows": {"type": "integer", "minimum": 4, "maximum": 12, "default": 9},
    "maxTicks": {"type": "integer", "minimum": 1, "maximum": 36000},
    "pickupInterval": {"type": "integer", "minimum": 1, "maximum": 3600},
    "scoreToWin": {"type": "integer", "minimum": 1, "maximum": 10, "default": 3},
    "shellSpeed": {"type": "number", "minimum": 3, "maximum": 9, "description": "Explicit override in world pixels per simulation tick."},
    "shrinkAfterSeconds": {"type": "integer", "minimum": 0, "maximum": 120, "default": 40},
    "shrinkDurationSeconds": {"type": "integer", "minimum": 1, "maximum": 120, "default": 15},
    "classicSolo": {"type": "boolean", "default": false},
    "roundLimit": {"type": "integer", "minimum": 0, "maximum": 20, "default": 0},
    "mazeComplexity": {"enum": ["open", "classic", "dense"], "default": "classic"},
    "friendlyFire": {"type": "boolean", "default": false},
    "teams": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-H]$"},
      "additionalProperties": {"enum": ["1", "2", "3", "4"]},
      "minProperties": 2,
      "maxProperties": 8,
      "description": "Assign every participating seat to one of at least two distinct teams."
    },
    "pickups": {"type": "boolean", "default": true}
  }
}
