{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tank Trouble v6 match config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cols": {"type": "integer", "minimum": 4, "maximum": 16, "default": 12},
    "rows": {"type": "integer", "minimum": 4, "maximum": 12, "default": 9},
    "maxTicks": {"type": "integer", "minimum": 1, "maximum": 36000, "default": 3600},
    "pickupInterval": {"type": "integer", "minimum": 1, "maximum": 3600, "default": 360},
    "scoreToWin": {"type": "integer", "minimum": 1, "maximum": 10, "default": 3},
    "shellSpeed": {"type": "number", "minimum": 3, "maximum": 9, "default": 5.2},
    "shrinkAfterSeconds": {"type": "integer", "minimum": 0, "maximum": 120, "default": 40},
    "shrinkDurationSeconds": {"type": "integer", "minimum": 1, "maximum": 120, "default": 15},
    "pickups": {"type": "boolean", "default": true}
  }
}
